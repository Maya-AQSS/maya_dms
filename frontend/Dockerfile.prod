# syntax=docker/dockerfile:1
#
# maya_dms — frontend de producción (React + Vite → nginx estático).
#
# Este fichero es IDÉNTICO en todas las apps Maya salvo el bloque "Parámetros
# de la app". nginx, cabeceras, /healthz y la configuración en ejecución
# (/config.js a partir de MAYA_PUBLIC_*) viven en la base maya/web-base.
#
# Build local:
#   docker build -f frontend/Dockerfile.prod -t maya/maya-dms-frontend:dev frontend
#
# TRANSITORIO: mientras la SPA lea import.meta.env en vez de window.__MAYA_CONFIG__,
# los VITE_* siguen horneándose en el build (--build-arg). Cuando las apps pasen a
# la configuración en ejecución, este bloque desaparece y la misma imagen sirve
# para cualquier entorno.

# ─── Parámetros de la app ─────────────────────────────────────────────────────
ARG MAYA_WEB_BASE=maya/web-base:1.29
ARG MAYA_APP=maya-dms
# ──────────────────────────────────────────────────────────────────────────────

# ─── 1. build: npm ci + vite build ───────────────────────────────────────────
FROM node:24-alpine AS build

WORKDIR /app
ENV CI=true

COPY package.json package-lock.json .npmrc ./
# --include=dev: vite y typescript son devDependencies y hacen falta para compilar.
RUN --mount=type=cache,target=/root/.npm \
    npm ci --include=dev --no-audit --no-fund

COPY . .

# Transitorio (ver cabecera): variables horneadas por Vite.
ARG VITE_API_URL
ARG VITE_KEYCLOAK_URL
ARG VITE_KEYCLOAK_REALM=CEED
ARG VITE_KEYCLOAK_CLIENT_ID=maya-dms
ARG VITE_DASHBOARD_URL
ARG VITE_DASHBOARD_API_URL
ARG VITE_REVERB_HOST
ARG VITE_REVERB_PORT=443
ARG VITE_REVERB_SCHEME=https
ARG VITE_REVERB_APP_KEY
ARG VITE_APP_NAME
ARG VITE_EDITOR_BACKEND

# Solo el bundle (esbuild). La comprobación de tipos (`tsc -b`, que incluye los
# tests) es un paso del CI, no de la imagen: un error de tipos en un test no debe
# impedir publicar, y un bundle no debe depender de que el checker esté verde.
ENV NODE_ENV=production
RUN npx vite build \
    && test -f dist/index.html

# ─── 2. runtime: nginx sin privilegios (maya/web-base) ───────────────────────
FROM ${MAYA_WEB_BASE}

ARG MAYA_APP
LABEL org.opencontainers.image.title="${MAYA_APP}-frontend"

COPY --from=build --chown=root:root /app/dist /usr/share/nginx/html
