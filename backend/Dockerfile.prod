# syntax=docker/dockerfile:1
#
# maya_dms — backend de producción. Tres imágenes desde la misma base:
#
#   --target worker  → consumidor / colas         (Deployment worker, scheduler y Job migrate)
#   --target reverb  → WebSocket Laravel Reverb   (Deployment reverb, puerto 8080)
#   --target api     → nginx + php-fpm            (Deployment backend, puerto 8080; target por defecto)
#
# Este fichero es IDÉNTICO en todas las apps Maya salvo el bloque "Parámetros
# de la app". Todo lo de sistema (PHP, extensiones, nginx, supervisord,
# entrypoint y roles) vive en la base maya/php-base de maya_platform.
#
# Build local (con la base construida en local):
#   docker build -f backend/Dockerfile.prod --target api    -t maya/maya-dms-api:dev    backend
#   docker build -f backend/Dockerfile.prod --target worker -t maya/maya-dms-worker:dev backend
#   docker build -f backend/Dockerfile.prod --target reverb -t maya/maya-dms-reverb:dev backend
# En CI se pasa --build-arg MAYA_PHP_BASE=<registry>/maya/php-base:8.4-<fecha>.

# ─── Parámetros de la app ─────────────────────────────────────────────────────
ARG MAYA_PHP_BASE=maya/php-base:8.4-pdf
ARG MAYA_APP=maya-dms
ARG MAYA_WORKER_CMD="queue:work --tries=3 --backoff=10 --max-time=3600 --sleep=1"
ARG PHP_MEMORY_LIMIT=512M
ARG PHP_UPLOAD_MAX=20M
ARG PHP_FPM_MAX_CHILDREN=8
# ──────────────────────────────────────────────────────────────────────────────

# ─── 1. vendor: composer sin dev ni scripts (no hay artisan en esta etapa) ────
FROM composer:2.9 AS vendor

WORKDIR /build

COPY composer.json composer.lock ./

# --ignore-platform-reqs: la imagen de composer no tiene las extensiones del
# runtime (pgsql, redis...); la etapa `app` valida que la app arranca de verdad.
# El secreto composer_auth es opcional (repos VCS privados): en CI se pasa con
# --secret id=composer_auth,env=COMPOSER_AUTH.
RUN --mount=type=cache,target=/tmp/cache \
    --mount=type=secret,id=composer_auth,env=COMPOSER_AUTH \
    composer install \
        --no-dev \
        --no-scripts \
        --no-interaction \
        --no-progress \
        --prefer-dist \
        --ignore-platform-reqs

COPY . .

# Autoloader optimizado con todo el código ya presente.
RUN composer dump-autoload --optimize --no-dev --no-scripts --no-interaction \
    && rm -f composer.local.json

# ─── 2. app: código + vendor sobre la base común ─────────────────────────────
FROM ${MAYA_PHP_BASE} AS app

ARG MAYA_APP
ARG PHP_MEMORY_LIMIT
ARG PHP_UPLOAD_MAX
ARG PHP_FPM_MAX_CHILDREN

USER root

# Límites propios de la app (el resto de php.ini viene de la base).
RUN printf 'memory_limit = %s\nupload_max_filesize = %s\npost_max_size = %s\n' \
        "$PHP_MEMORY_LIMIT" "$PHP_UPLOAD_MAX" "$PHP_UPLOAD_MAX" \
        > /usr/local/etc/php/conf.d/90-app.ini \
    && printf '[www]\npm.max_children = %s\n' "$PHP_FPM_MAX_CHILDREN" \
        > /usr/local/etc/php-fpm.d/90-app.conf

# El código es de root y solo lectura para la app; storage/ y bootstrap/cache
# son de www-data (en k8s se montan como emptyDir).
COPY --from=vendor --chown=root:root /build /var/www/html
RUN mkdir -p storage/app/public storage/framework/cache/data storage/framework/sessions \
             storage/framework/views storage/framework/testing storage/logs bootstrap/cache \
    && chown -R www-data:www-data storage bootstrap/cache

ENV APP_NAME=${MAYA_APP}

USER 82:82

# Validación en build: la app tiene que poder generar sus cachés con un entorno
# mínimo ficticio (sin base de datos). Si una config lanza excepción o hay rutas
# con closures, falla aquí y no en el arranque del pod.
# hadolint ignore=DL4006
# (la base maya/php-base define SHELL bash con pipefail; hadolint no lo ve)
RUN set -eu; \
    APP_KEY="base64:$(head -c 32 /dev/urandom | base64)"; \
    export APP_KEY APP_ENV=production APP_DEBUG=false LOG_CHANNEL=stderr \
           DB_CONNECTION=pgsql DB_HOST=127.0.0.1 DB_PASSWORD=build \
           CACHE_STORE=array SESSION_DRIVER=array QUEUE_CONNECTION=sync \
           BROADCAST_CONNECTION=log JWT_AUDIENCE=build \
           RABBITMQ_USER=build RABBITMQ_PASSWORD=build \
           LOG_MGMT_DB_PASSWORD=build; \
    php artisan package:discover --no-interaction; \
    php artisan config:cache     --no-interaction; \
    php artisan route:cache      --no-interaction; \
    php artisan event:cache      --no-interaction; \
    if [ -d resources/views ]; then php artisan view:cache --no-interaction; fi; \
    php artisan optimize:clear   --no-interaction; \
    rm -f bootstrap/cache/*.php

# ─── 3. Imágenes finales ─────────────────────────────────────────────────────
FROM app AS worker
ARG MAYA_WORKER_CMD
LABEL org.opencontainers.image.title="${MAYA_APP}-worker"
ENV CONTAINER_ROLE=worker \
    MAYA_WORKER_CMD=${MAYA_WORKER_CMD}
CMD ["worker"]

FROM app AS reverb
LABEL org.opencontainers.image.title="${MAYA_APP}-reverb"
ENV CONTAINER_ROLE=reverb
CMD ["reverb"]

FROM app AS api
# Último target: es el que genera `docker build` sin --target.
LABEL org.opencontainers.image.title="${MAYA_APP}-api"
ENV CONTAINER_ROLE=api
HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 \
    CMD ["curl", "-fsS", "-o", "/dev/null", "http://127.0.0.1:8080/api/v1/health/live"]
CMD ["api"]
